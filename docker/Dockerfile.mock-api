# Mock API (Member 5) — synthetic e-commerce lab API.
# Run command mirrors mock-api/README.md; the container binds 0.0.0.0 and
# compose publishes it on host 127.0.0.1 only. No secrets are baked in.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY mock-api/ ./mock-api/
COPY src/ ./src/

RUN useradd --create-home lab && chown -R lab:lab /app
USER lab

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "main:app", "--app-dir", "mock-api", \
     "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
